{% comment %}
  Renders an image/logo bank section.

  Supports:
  - Static grid
  - Slider / marquee

  Static mode is intended for logo banks where all logos should be visible,
  especially on mobile.

  Static grid behaviour:
  - Full rows use the selected column count.
  - If the final row is incomplete, remaining items are distributed evenly
    across the row instead of bunching to the left.
{% endcomment %}

{%- liquid
  assign display_type = section.settings.display_type | default: 'slider'

  if display_type == 'slider'
    assign is_slider = true
  else
    assign is_slider = false
  endif

  assign static_block_count = section.blocks.size

  assign static_columns_mobile = section.settings.static_columns_mobile | default: 3
  assign static_columns_desktop = section.settings.static_columns_desktop | default: 6

  assign mobile_remainder = static_block_count | modulo: static_columns_mobile
  assign desktop_remainder = static_block_count | modulo: static_columns_desktop

  assign static_grid_classes = 'v2-logo-grid'

  if mobile_remainder > 0
    assign static_grid_classes = static_grid_classes | append: ' -mobile-incomplete-row'
    assign static_grid_classes = static_grid_classes | append: ' -mobile-remainder-' | append: mobile_remainder
  endif

  if desktop_remainder > 0
    assign static_grid_classes = static_grid_classes | append: ' -desktop-incomplete-row'
    assign static_grid_classes = static_grid_classes | append: ' -desktop-remainder-' | append: desktop_remainder
  endif
-%}

{%- if is_slider -%}
  {{ 'le_swiper-bundle.min.css' | asset_url | stylesheet_tag }}
  {{ 'le_swiper-bundle.min.js' | asset_url | script_tag }}
{%- endif -%}

{%- liquid
  assign section_classes = ''

  # ---------------------------------
  # DECALS
  # ---------------------------------
  assign decal_top = false
  assign decal_bottom = false

  if section.settings.decal_top
    assign decal_top = true
    assign section_classes = section_classes | append: ' -decal-top '
  endif

  if section.settings.decal_bottom
    assign decal_bottom = true
    assign section_classes = section_classes | append: ' -decal-bottom '
  endif

  # ---------------------------------
  # BACKGROUND + DECAL - colors
  # ---------------------------------
  assign section_classes = section_classes | append: ' sa-bg-' | append: section.settings.bkgr_color
  assign section_classes = section_classes | append: ' -dct-' | append: section.settings.bkgr_color
  assign section_classes = section_classes | append: ' -dcb-' | append: section.settings.bkgr_color

  if section.settings.bkgr_color == 'primary'
    assign section_classes = section_classes | append: ' sa-col-white '
  endif

  if section.settings.bkgr_color == 'light-blue' or section.settings.bkgr_color == 'white'
    assign section_classes = section_classes | append: ' sa-col-primary '
  endif

  # ---------------------------------
  # PADDING + MARGIN
  # ---------------------------------
  assign section_classes = section_classes | append: ' section-' | append: section.id | append: '-margin '
  assign section_classes = section_classes | append: ' section-' | append: section.id | append: '-padding '

  # ---------------------------------
  # CUSTOM CLASSES
  # ---------------------------------
  assign section_classes = section_classes | append: ' ' | append: section.settings.custom_class_names

  # ---------------------------------
  # DISPLAY TYPE CLASSES
  # ---------------------------------
  assign section_classes = section_classes | append: ' -display-' | append: display_type
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-margin {
    margin-top: {% if decal_top %}{{ section.settings.margin_top | plus: 140 | times: 0.75 | round: 0 }}{% else %}{{ section.settings.margin_top }}{% endif %}px !important;
    margin-bottom: {% if decal_bottom %}{{ section.settings.margin_bottom | plus: 140 | times: 0.75 | round: 0 }}{% else %}{{ section.settings.margin_bottom }}{% endif %}px !important;
  }

  .v2-section-image-slider.section-{{ section.id }}-padding {
    overflow: hidden;
  }

  .v2-section-image-slider .v2-slider-wrapper {
    width: 100%;
  }

  /*
    Static logo grid
    ----------------------------
    Uses flexbox so incomplete final rows are centred.
    Example with 5 logos and 3 columns:
    item | item | item
        item | item
  */
  #LogoGrid-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    column-gap: {{ section.settings.static_gap_mobile }}px;
    row-gap: {{ section.settings.static_gap_mobile }}px;
  }

  #LogoGrid-{{ section.id }} .v2-logo-grid-item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    width: calc(
      (100% - ({{ static_columns_mobile | minus: 1 }} * {{ section.settings.static_gap_mobile }}px))
      / {{ static_columns_mobile }}
    );
  }

  /*
    Static logo grid: incomplete final row handling - mobile
    -------------------------------------------------------
    The final row is spread evenly across the selected column count.
  */

  #LogoGrid-{{ section.id }}.-mobile-incomplete-row.-mobile-remainder-1 .v2-logo-grid-item:nth-last-child(1) {
    grid-column: 1 / -1;
  }

  #LogoGrid-{{ section.id }}.-mobile-incomplete-row.-mobile-remainder-2 .v2-logo-grid-item:nth-last-child(2) {
    grid-column: 1 / 2;
  }

  #LogoGrid-{{ section.id }}.-mobile-incomplete-row.-mobile-remainder-2 .v2-logo-grid-item:nth-last-child(1) {
    grid-column: {{ static_columns_mobile }} / {{ static_columns_mobile | plus: 1 }};
  }

  #LogoGrid-{{ section.id }}.-mobile-incomplete-row.-mobile-remainder-3 .v2-logo-grid-item:nth-last-child(3) {
    grid-column: 1 / 2;
  }

  #LogoGrid-{{ section.id }}.-mobile-incomplete-row.-mobile-remainder-3 .v2-logo-grid-item:nth-last-child(2) {
    grid-column: 2 / 3;
  }

  #LogoGrid-{{ section.id }}.-mobile-incomplete-row.-mobile-remainder-3 .v2-logo-grid-item:nth-last-child(1) {
    grid-column: {{ static_columns_mobile }} / {{ static_columns_mobile | plus: 1 }};
  }

  /*
    Slider / marquee
    ----------------------------
  */
  #swiper-{{ section.id }} .swiper-wrapper {
    align-items: center;
    transition-timing-function: linear;
  }

  #swiper-{{ section.id }} .swiper-slide {
    width: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #swiper-{{ section.id }} .swiper-slide img,
  #swiper-{{ section.id }} .swiper-slide svg {
    display: block;
    width: auto;
    max-width: {{ section.settings.logo_max_width_mobile }}px;
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}-margin {
      margin-top: {% if decal_top %}{{ section.settings.margin_top | plus: 140 }}{% else %}{{ section.settings.margin_top }}{% endif %}px !important;
      margin-bottom: {% if decal_bottom %}{{ section.settings.margin_bottom | plus: 140 }}{% else %}{{ section.settings.margin_bottom }}{% endif %}px !important;
    }

    #LogoGrid-{{ section.id }} {
      grid-template-columns: repeat({{ static_columns_desktop }}, minmax(0, 1fr));
      gap: {{ section.settings.static_gap_desktop }}px;
    }

    /*
      Reset mobile incomplete-row positioning before applying desktop rules.
    */
    #LogoGrid-{{ section.id }} .v2-logo-grid-item {
      grid-column: auto;
    }

    #LogoGrid-{{ section.id }} .v2-logo-grid-item img,
    #LogoGrid-{{ section.id }} .v2-logo-grid-item svg {
      max-width: {{ section.settings.logo_max_width_desktop }}px;
    }

    /*
      Static logo grid: incomplete final row handling - desktop
      --------------------------------------------------------
      The final row is spread evenly across the selected column count.
    */

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-1 .v2-logo-grid-item:nth-last-child(1) {
      grid-column: 1 / -1;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-2 .v2-logo-grid-item:nth-last-child(2) {
      grid-column: 1 / 2;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-2 .v2-logo-grid-item:nth-last-child(1) {
      grid-column: {{ static_columns_desktop }} / {{ static_columns_desktop | plus: 1 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-3 .v2-logo-grid-item:nth-last-child(3) {
      grid-column: 1 / 2;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-3 .v2-logo-grid-item:nth-last-child(2) {
      grid-column: {{ static_columns_desktop | divided_by: 2 | plus: 1 }} / {{ static_columns_desktop | divided_by: 2 | plus: 2 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-3 .v2-logo-grid-item:nth-last-child(1) {
      grid-column: {{ static_columns_desktop }} / {{ static_columns_desktop | plus: 1 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-4 .v2-logo-grid-item:nth-last-child(4) {
      grid-column: 1 / 2;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-4 .v2-logo-grid-item:nth-last-child(3) {
      grid-column: {{ static_columns_desktop | divided_by: 3 | plus: 1 }} / {{ static_columns_desktop | divided_by: 3 | plus: 2 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-4 .v2-logo-grid-item:nth-last-child(2) {
      grid-column: {{ static_columns_desktop | times: 2 | divided_by: 3 | plus: 1 }} / {{ static_columns_desktop | times: 2 | divided_by: 3 | plus: 2 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-4 .v2-logo-grid-item:nth-last-child(1) {
      grid-column: {{ static_columns_desktop }} / {{ static_columns_desktop | plus: 1 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-5 .v2-logo-grid-item:nth-last-child(5) {
      grid-column: 1 / 2;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-5 .v2-logo-grid-item:nth-last-child(4) {
      grid-column: {{ static_columns_desktop | divided_by: 4 | plus: 1 }} / {{ static_columns_desktop | divided_by: 4 | plus: 2 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-5 .v2-logo-grid-item:nth-last-child(3) {
      grid-column: {{ static_columns_desktop | divided_by: 2 | plus: 1 }} / {{ static_columns_desktop | divided_by: 2 | plus: 2 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-5 .v2-logo-grid-item:nth-last-child(2) {
      grid-column: {{ static_columns_desktop | times: 3 | divided_by: 4 | plus: 1 }} / {{ static_columns_desktop | times: 3 | divided_by: 4 | plus: 2 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-5 .v2-logo-grid-item:nth-last-child(1) {
      grid-column: {{ static_columns_desktop }} / {{ static_columns_desktop | plus: 1 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-6 .v2-logo-grid-item:nth-last-child(6) {
      grid-column: 1 / 2;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-6 .v2-logo-grid-item:nth-last-child(5) {
      grid-column: {{ static_columns_desktop | divided_by: 5 | plus: 1 }} / {{ static_columns_desktop | divided_by: 5 | plus: 2 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-6 .v2-logo-grid-item:nth-last-child(4) {
      grid-column: {{ static_columns_desktop | times: 2 | divided_by: 5 | plus: 1 }} / {{ static_columns_desktop | times: 2 | divided_by: 5 | plus: 2 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-6 .v2-logo-grid-item:nth-last-child(3) {
      grid-column: {{ static_columns_desktop | times: 3 | divided_by: 5 | plus: 1 }} / {{ static_columns_desktop | times: 3 | divided_by: 5 | plus: 2 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-6 .v2-logo-grid-item:nth-last-child(2) {
      grid-column: {{ static_columns_desktop | times: 4 | divided_by: 5 | plus: 1 }} / {{ static_columns_desktop | times: 4 | divided_by: 5 | plus: 2 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-6 .v2-logo-grid-item:nth-last-child(1) {
      grid-column: {{ static_columns_desktop }} / {{ static_columns_desktop | plus: 1 }};
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-7 .v2-logo-grid-item:nth-last-child(7) {
      grid-column: 1 / 2;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-7 .v2-logo-grid-item:nth-last-child(6) {
      grid-column: 2 / 3;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-7 .v2-logo-grid-item:nth-last-child(5) {
      grid-column: 3 / 4;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-7 .v2-logo-grid-item:nth-last-child(4) {
      grid-column: 4 / 5;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-7 .v2-logo-grid-item:nth-last-child(3) {
      grid-column: 5 / 6;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-7 .v2-logo-grid-item:nth-last-child(2) {
      grid-column: 6 / 7;
    }

    #LogoGrid-{{ section.id }}.-desktop-incomplete-row.-desktop-remainder-7 .v2-logo-grid-item:nth-last-child(1) {
      grid-column: 7 / 8;
    }

    #swiper-{{ section.id }} .swiper-slide img,
    #swiper-{{ section.id }} .swiper-slide svg {
      max-width: {{ section.settings.logo_max_width_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="v2-section-image-slider {{ section_classes }}">
  <div class="v2-slider-wrapper page-width">

    {%- if is_slider -%}

      <div id="swiper-{{ section.id }}" class="swiper sa-slider">
        <div class="swiper-wrapper">

          {% for i in (1..2) %}
            {%- for block in section.blocks -%}
              <div
                id="Slide-{{ section.id }}-{{ forloop.index }}-{{ i }}"
                class="swiper-slide"
                role="group"
                aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image -%}
                  {%- liquid
                    assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
                    assign sizes = '100vw'
                    assign widths = '120, 180, 240, 320, 375, 550, 750'
                    assign fetch_priority = 'auto'

                    if section.index == 1 and forloop.first
                      assign fetch_priority = 'high'
                    endif

                    assign image_alt = block.settings.image_alt | default: block.settings.image.alt | default: shop.name
                  -%}

                  {%- if forloop.first and i == 1 -%}
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag:
                        alt: image_alt,
                        height: height,
                        sizes: sizes,
                        widths: widths,
                        fetchpriority: fetch_priority
                    }}
                  {%- else -%}
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag:
                        alt: image_alt,
                        loading: 'lazy',
                        height: height,
                        sizes: sizes,
                        widths: widths
                    }}
                  {%- endif -%}
                {%- else -%}
                  {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
                  {%- if placeholder_slide == 1 -%}
                    {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- else -%}
                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endfor -%}
          {% endfor %}

        </div>
      </div>

      <script>
        document.addEventListener("DOMContentLoaded", function () {
          var swiperElement = document.querySelector("#swiper-{{ section.id }}");

          if (!swiperElement || typeof Swiper === "undefined") {
            return;
          }

          new Swiper("#swiper-{{ section.id }}", {
            direction: "horizontal",
            loop: true,
            slidesPerView: "auto",
            speed: {{ section.settings.slide_autospeed }},
            autoplay: {
              delay: 0,
              disableOnInteraction: false,
              pauseOnMouseEnter: false
            },
            spaceBetween: {{ section.settings.slider_space_between }},
            allowTouchMove: {{ section.settings.slider_allow_touch }},
            watchOverflow: true
          });
        });
      </script>

    {%- else -%}

      <div
        id="LogoGrid-{{ section.id }}"
        class="{{ static_grid_classes }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <div
            class="v2-logo-grid-item"
            role="listitem"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image -%}
              {%- liquid
                assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
                assign sizes = '(max-width: 749px) 33vw, 16vw'
                assign widths = '120, 180, 240, 320, 375, 550, 750'
                assign fetch_priority = 'auto'

                if section.index == 1 and forloop.first
                  assign fetch_priority = 'high'
                endif

                assign image_alt = block.settings.image_alt | default: block.settings.image.alt | default: shop.name
              -%}

              {%- if forloop.first -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    alt: image_alt,
                    height: height,
                    sizes: sizes,
                    widths: widths,
                    fetchpriority: fetch_priority
                }}
              {%- else -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    alt: image_alt,
                    loading: 'lazy',
                    height: height,
                    sizes: sizes,
                    widths: widths
                }}
              {%- endif -%}
            {%- else -%}
              {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
              {%- if placeholder_slide == 1 -%}
                {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- else -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "t:lesections.v2_image-slider.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "display_type",
      "label": "Display type",
      "default": "slider",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "static",
          "label": "Static grid"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "range",
      "id": "slide_autospeed",
      "min": 1000,
      "max": 9500,
      "step": 500,
      "unit": "ms",
      "label": "t:lebase.global.slider.autospeed",
      "default": 4000
    },
    {
      "type": "range",
      "id": "slider_space_between",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Slider spacing",
      "default": 42
    },
    {
      "type": "checkbox",
      "id": "slider_allow_touch",
      "label": "Allow touch dragging",
      "default": true
    },
    {
      "type": "header",
      "content": "Static grid settings"
    },
    {
      "type": "range",
      "id": "static_columns_mobile",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on mobile",
      "default": 3
    },
    {
      "type": "range",
      "id": "static_columns_desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "label": "Columns on desktop",
      "default": 6
    },
    {
      "type": "range",
      "id": "static_gap_mobile",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile logo spacing",
      "default": 24
    },
    {
      "type": "range",
      "id": "static_gap_desktop",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop logo spacing",
      "default": 32
    },
    {
      "type": "range",
      "id": "logo_max_width_mobile",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Logo max width on mobile",
      "default": 104
    },
    {
      "type": "range",
      "id": "logo_max_width_desktop",
      "min": 60,
      "max": 260,
      "step": 4,
      "unit": "px",
      "label": "Logo max width on desktop",
      "default": 160
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bkgr_color",
      "label": "Background colour",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "light-blue",
          "label": "Light blue"
        },
        {
          "value": "dark-blue",
          "label": "Dark blue"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "decal_top",
      "label": "Skewed on top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "decal_bottom",
      "label": "Skewed on bottom",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.section_margin_heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": -200,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.margin.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": -200,
