{{ 'le_swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'le_swiper-bundle.min.js' | asset_url | script_tag }}

{%- liquid

    assign section_classes = ''

    # ---------------------------------
    # DECALS
    # ---------------------------------
    assign decal_top = false
    assign decal_bottom = false

    if section.settings.decal_top
        assign decal_top = true
        assign section_classes = section_classes | append: ' -decal-top '
    endif

    if section.settings.decal_bottom
        assign decal_bottom = true
        assign section_classes = section_classes | append: ' -decal-bottom '
    endif

    # ---------------------------------
    # BACKGROUND + DECAL - colors
    # ---------------------------------
    assign section_classes = section_classes | append: ' sa-bg-' | append: section.settings.bkgr_color
    assign section_classes = section_classes | append: ' -dct-' | append: section.settings.bkgr_color
    assign section_classes = section_classes | append: ' -dcb-' | append: section.settings.bkgr_color
    if section.settings.bkgr_color == 'primary'
        assign section_classes = section_classes | append: ' sa-col-white '
    endif
    if section.settings.bkgr_color == 'light-blue' or section.settings.bkgr_color == 'white'
        assign section_classes = section_classes | append: ' sa-col-primary '
    endif

    # ---------------------------------
    # PADDING + MARGIN
    # ---------------------------------
    assign section_classes = section_classes | append: ' section-' | append: section.id | append: '-margin '
    assign section_classes = section_classes | append: ' section-' | append: section.id | append: '-padding '

    # ---------------------------------
    # CUSTOM CLASSES
    # ---------------------------------
    assign section_classes = section_classes | append: section.settings.custom_class_names

    # ---------------------------------
    # CHECK VIEW MODE
    # ---------------------------------
    assign mode_live = true
    assign mode_preview = false
    assign mode_customizer = false
    if content_for_header contains "previewBarInjector.init();"
        assign mode_live = false
        assign mode_preview = true
        assign mode_customizer = false
    elsif content_for_header contains "Shopify.designMode"
        assign mode_live = false
        assign mode_preview = false
        assign mode_customizer = true
    endif

    # ---------------------------------
    # SECTION SPECIFIC STUFF
    # ---------------------------------
    # ...
%}

{%- style -%}
    .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    .section-{{ section.id }}-margin {
        margin-top: {% if decal_top %}{{ section.settings.margin_top | times: 0.75 | round: 0 | plus: 105 }}{% else %}{{ section.settings.margin_top }}{% endif %}px;
        margin-bottom: {% if decal_bottom %}{{ section.settings.margin_bottom | times: 0.75 | round: 0 | plus: 105 }}{% else %}{{ section.settings.margin_bottom }}{% endif %}px;
    }

    @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
            padding-top: {{ section.settings.padding_top }}px;
            padding-bottom: {{ section.settings.padding_bottom }}px;
        }
        .section-{{ section.id }}-margin {
            margin-top: {% if decal_top %}{{ section.settings.margin_top | plus: 140 }}{% else %}{{ section.settings.margin_top }}{% endif %}px;
            margin-bottom: {% if decal_bottom %}{{ section.settings.margin_bottom | plus: 140 }}{% else %}{{ section.settings.margin_bottom }}{% endif %}px;
        }
    }
{%- endstyle -%}

{% liquid
    assign iz_slide = true
    assign iz_product = false
    assign iz_blog = false
    if section.settings.slide_type == 'product' or section.settings.slide_type == 'bundle'
        assign iz_slide = false
        assign iz_product = true
    endif
    if section.settings.slide_type == 'blog'
        assign iz_slide = false
        assign iz_blog = true
    endif
%}

<div class="v2-section-slideshow
            {{ section_classes }}">
    <div class="page-width -wide">

        <div id="swiper-{{ section.id }}" class="swiper v2-swiper -slide-type-{{ section.settings.slide_type }}">
            <div class="swiper-wrapper sa-col-white">

            {% case section.settings.slide_type %}
                {% when 'blue' or 'dark' %}

                    {%- for block in section.blocks -%}

                        <div id="Slide-{{ section.id }}-{{ forloop.index }}"
                             class="swiper-slide"
                             role="group"
                             aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                             aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                             tabindex="-1" >

                            {% render 'v2-slide',
                                    slide_type: 'product',
                                    slide_image: block.settings.image,
                                    section_index: section.index,
                                    forloop: forloop,
                                    slide_headline: block.settings.headline,
                                    slide_subheadline: block.settings.subheadline,
                                    slide_text: block.settings.text,
                                    slide_button_label: block.settings.button_label
                            %}

                        </div>

                    {% endfor %}

                {% when 'product' or 'bundle' %}

                    {%- for product in collection.products -%}

                        {% assign lazy_load = false %}
                        {%- if forloop.index > 2 -%}
                            {%- assign lazy_load = true -%}
                        {%- endif -%}

                        {% if product.type == 'Bundle' or forloop.index == 1 or section.settings.slide_type == 'product' %}

                            {% assign thumb_id = section.id | append: forloop.index %}

                        <div id="Slide-{{ section.id }}-{{ forloop.index }}"
                             class="swiper-slide"
                             role="group"
                             aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                             aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                             tabindex="-1" >

                            <div class="v2-swiper-inside">
                            {% render 'v2_product-thumb',
                                    section_id: thumb_id,
                                    product: product,
                                    loopindex: forloop.index,
                                    shopify_attributes: ''
                            %}
                            </div>
                        </div>

                        {% endif %}
                    {%- endfor -%}

                {% when 'blog' %}

                    {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
                        {%- for article in section.settings.blog.articles limit: section.settings.blog_post_limit -%}

                            <div id="Slide-{{ section.id }}-{{ forloop.index }}"
                                 class="swiper-slide"
                                 role="group"
                                 aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                                 aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                 tabindex="-1" >

                                    {%- if article.excerpt.size > 0 or article.content.size > 0 -%}
                                        {%- if article.excerpt.size > 0 -%}
                                            {%  assign article_text = article.excerpt | strip_html | truncatewords: 30 %}
                                        {%- else -%}
                                            {%  assign article_text = article.content | strip_html | truncatewords: 30 %}
                                        {%- endif -%}
                                    {%- endif -%}


                                    {% render 'v2-slide',
                                            item: article,
                                            slide_type: 'blog',
                                            slide_image: article.image,
                                            section_index: section.index,
                                            forloop: forloop,
                                            slide_headline: article.title,
                                            slide_text: article_text,
                                            slide_button_label: 'Lets go'
                                    %}

                            </div>

                        {% endfor %}
                    {% endif %}

                {% when 'product_manual' %}

                    {% if section.settings.product_list != blank %}
                        {% for product in section.settings.product_list %}

                            <div id="Slide-{{ section.id }}-{{ forloop.index }}"
                                     class="swiper-slide"
                                     role="group"
                                     aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                                     aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                     tabindex="-1" >

                                    {% assign thumb_id = section.id | append: forloop.index %}

                                    {% render 'v2_product-thumb',
                                        section_id: thumb_id,
                                        product: product,
                                        template_type: 'product_thumb',
                                        extra_classes: ' v2-swiper-inside '
                                    %}

                                        {% comment %}{% render 'v2-slide',
                                                item: article,
                                                slide_type: 'product_manual',
                                                slide_image: article.image,
                                                section_index: section.index,
                                                forloop: forloop,
                                                slide_headline: article.title,
                                                slide_text: article_text,
                                                slide_button_label: 'Lets go'
                                        %}{% endcomment %}

                            </div>

                        {% endfor %}
                    {% endif %}

                {% endcase %}
            </div>

            <div class="swiper-pagination"></div>

            {% # BUTTONS
               # ---------------------- %}
            {% comment %}<div class="swiper-button-wrapper">

                <div class="sa-swiper-button-prev v2-button -hover-translate">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none">
                          <path d="M7.179 16.5L17.4457 26.7667L14.8332 29.3333L0.166504 14.6667L14.8332 0L17.4457 2.56667L7.179 12.8333H29.4998V16.5H7.179Z" fill="white"/>
                        </svg>
                    </span>
                </div>

                <div class="sa-swiper-button-next v2-button -hover-translate">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none">
                          <path d="M22.8208 16.5H0.5V12.8333H22.8208L12.5542 2.56667L15.1667 0L29.8333 14.6667L15.1667 29.3333L12.5542 26.7667L22.8208 16.5Z" fill="white"/>
                        </svg>
                    </span>
                </div>

            </div>{% endcomment %}

        </div>

        <script>
            // TODO: differentiate between autorotate and autoplay
            var swiper = new Swiper("#swiper-{{ section.id }}", {
                spaceBetween: 0,

                navigation: {
                    nextEl: ".sa-swiper-button-next",
                    prevEl: ".sa-swiper-button-prev",
                },

                loop: false,

                speed: 1000,

                pagination: {
                    el: ".swiper-pagination",
                    clickable: true,
                },

                {%- if section.settings.auto_rotate -%}
                autoplay: {
                    delay: {{ section.settings.change_slides_speed }}000,
                    disableOnInteraction: false,
                },
                {% else %}
                autoplay: false,
                {% endif %}

                slidesPerView: 'auto',
                //
                // breakpoints: {
                //     530: {
                //         slidesPerView: 2
                //     },
                //     // when window width is >= 640px
                //     900: {
                //         slidesPerView: 3
                //     }
                // }

            });

        </script>

    </div> {% # /PAGE WIDTH %}
</div>

{% schema %}
    {
        "name": "t:lesections.v2_slideshow.name",
        "tag": "section",
        "class": "section",
        "disabled_on": {
            "groups": ["header", "footer"]
        },
        "settings": [


            {
                "type": "select",
                "id": "slide_type",
                "label": "Slide Type",
                "default": "product",
                "options": [
                    {
                        "value": "blue",
                        "label": "Blue"
                    },
                    {
                        "value": "dark",
                        "label": "Dark Blue + Link"
                    },
                    {
                        "value": "blog",
                        "label": "Blog"
                    },
                    {
                        "value": "product",
                        "label": "Products (only for Collections)"
                    },
                    {
                        "value": "product_manual",
                        "label": "Products (manual selection)"
                    },
                    {
                        "value": "bundle",
                        "label": "Bundles (+1st Product)"
                    }
                ]
            },


            {
                "type": "header",
                "content": "Type: Blog"
            },
            {
                "type": "blog",
                "id": "blog",
                "label": "t:sections.featured-blog.settings.blog.label"
            },
            {
                "type": "range",
                "id": "blog_post_limit",
                "min": 2,
                "max": 20,
                "step": 1,
                "default": 3,
                "label": "t:sections.featured-blog.settings.post_limit.label",
            },


            {
                "type": "header",
                "content": "Type: Products - Manual Selection"
            },
            {
                "type": "product_list",
                "id": "product_list",
                "label": "Products",
                "limit": 12
            },


            {
                "type": "header",
                "content": "Slider Control"
            },
            {
                "type": "checkbox",
                "id": "auto_rotate",
                "label": "t:sections.slideshow.settings.auto_rotate.label",
                "default": false
            },
            {
                "type": "range",
                "id": "change_slides_speed",
                "min": 3,
                "max": 9,
                "step": 2,
                "unit": "s",
                "label": "t:sections.slideshow.settings.change_slides_speed.label",
                "default": 5
            },





            {
                "type": "header",
                "content": "t:lebase.global.custom_classes.header"
            },
            {
                "type": "text",
                "id": "custom_class_names",
                "label": "t:lebase.global.custom_classes.label",
                "placeholder": "test_class"
            },



            {
                "type": "header",
                "content": "t:lebase.global.background.header"
            },
            {
                "type": "select",
                "id": "bkgr_color",
                "label": "t:lebase.global.bkgr_color.label",
                "default": "light-blue",
                "options": [
                    {
                    "value": "primary",
                    "label": "t:lebase.global.bkgr_color.primary"
                    },
                    {
                    "value": "light-blue",
                    "label": "t:lebase.global.bkgr_color.light-blue"
                    },
                    {
                    "value": "white",
                    "label": "t:lebase.global.bkgr_color.white"
                    }
                ]
            },



            {
                "type": "header",
                "content": "t:lebase.global.skewed_border.header"
            },
            {
                "type": "checkbox",
                "id": "decal_top",
                "label": "t:lebase.global.skewed_border.label_top",
                "default": false
            },
            {
                "type": "checkbox",
                "id": "decal_bottom",
                "label": "t:lebase.global.skewed_border.label_bottom",
                "default": false
            },



            {
                "type": "header",
                "content": "t:lebase.global.padding.header"
            },
            {
                "type": "range",
                "id": "padding_top",
                "min": 0,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:lebase.global.padding.label_top",
                "default": 40
            },
            {
                "type": "range",
                "id": "padding_bottom",
                "min": 0,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:lebase.global.padding.label_bottom",
                "default": 40
            },


            {
                "type": "header",
                "content": "t:lebase.global.margin.header"
            },
            {
                "type": "range",
                "id": "margin_top",
                "min": -200,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:lebase.global.margin.label_top",
                "default": 0
            },
            {
                "type": "range",
                "id": "margin_bottom",
                "min": -200,
                "max": 200,
                "step": 4,
                "unit": "px",
                "label": "t:lebase.global.margin.label_bottom",
                "default": 0
            },

        ],

        "blocks": [
            {
                "type": "slide",
                "name": "t:lesections.v2_slideshow.blocks.slide.name",
                "limit": 37,
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "t:lesections.v2_slideshow.blocks.slide.image"
                    },
                    {
                        "type": "richtext",
                        "id": "headline",
                        "label": "t:lesections.v2_slideshow.blocks.slide.headline"
                    },
                    {
                        "type": "richtext",
                        "id": "subheadline",
                        "label": "t:lesections.v2_slideshow.blocks.slide.subheadline"
                    },
                    {
                        "type": "richtext",
                        "id": "text",
                        "label": "t:lesections.v2_slideshow.blocks.slide.text"
                    },
                    {
                        "type": "text",
                        "id": "button_label",
                        "label": "t:lesections.v2_slideshow.blocks.slide.button_label"
                    },
                    {
                        "type": "url",
                        "id": "button_url",
                        "label": "t:lesections.v2_slideshow.blocks.slide.button_url"
                    }
                ]
            }
        ],

         "presets": [
        {
          "name": "t:lesections.v2_slideshow.presets.name"
        }
    ]
    }
{% endschema %}