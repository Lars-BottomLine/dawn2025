{% comment %}
  Renders a product thumbnail for le_featured and the collections product list

  Accepts:
    - section_id: section.id,
    - product: product,
    - loopindex - where in the loop cycle are we for this section MUST be 1 at least once per page because otherwise necessary scripts won't be loaded
    - full_size: boolean
    - template_type: string ( full_size, normal, product_hero, product_thumb )
    - shopify_attributes: '',
    - extra_classes: string
  Usage:
  {% render 'card-product', section_id: section.id %}
{% endcomment %}

{% liquid
    assign first_call_on_page = false
    if loopindex == 1 or loopindex == blank
        assign first_call_on_page = true
    endif

    if template_type == blank
        assign template_type = 'normal'
    endif
    assign product_classes = extra_classes
    assign class_title = '_font-copy-l'
    assign class_description = '_font-copy-m'
    assign class_description = ' _font-copy-l'
    assign title_tag = 'h4'
    assign classes_button = ''

    case template_type
        when 'full_size'
            assign product_classes = product_classes | append: ' -full-size '
            assign class_title = '_font-h2'
            assign class_description = ' _font-copy-l'
            assign class_description = ' _font-copy-l'
        when 'product_hero'
            assign product_classes = product_classes | append: ' -full-size '
            assign class_title = '_font-h2'
            assign class_description = ' _font-copy-l'
            assign classes_button = ' -size-medium '
            assign title_tag = 'h1'
        when 'product_thumb'
            assign class_title = ' _font-copy-l !font-bold '
            assign class_description = ' _font-copy-m '
    endcase

    assign product_classes = product_classes | append: ' -template-' | append: template_type
    assign product_classes = product_classes | append: ' -sectionid-' | append: section_id

    assign media_image_count = 0
    if product.media
        assign media_image_count = product.media | size
    endif

    assign haz_featured = false
    assign not_haz_featured = true
    if product.metafields.custom.featured_image != blank
        assign haz_featured = true
        assign not_haz_featured = false
    endif


%}

{% if first_call_on_page %}
    <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% liquid
    assign product_tags = ''
    for tag in product.tags
        assign slug = tag | handle
        if forloop.index != 1
            assign product_tags = product_tags | append: ','
        endif
        assign product_tags = product_tags | append: slug
    endfor
%}

<product-thumb class="v2-product-thumb sa-col-white
                      sa-col-primary
                      {{ product_classes }}"
               data-product-tags="{{ product_tags }}"
               data-product-id="{{ product.id }}"
               data-product-url="{{ product.url }}">
    {% if product != blank %}
        <div class="pt-container">

            <div class="product-content">

                {% # TOP: MEDIA
                   # ---------------------- %}
                <div class="product__media-wrapper">
                    <div class="v2-pt-image">
                        {%- unless placeholder -%}
                            {% # TODO: set the correct sizes here depending on the use %}
                            {% if template_type == 'product_thumb' %}
                                {% if haz_featured %}
                                        {{ product.metafields.custom.featured_image
                                            | image_url: width: 800
                                            | image_tag }}
                                    {% else %}
                                        {% if product.media[0] != blank %}
                                            {% render 'v2-product-media', media: product.media[0], variant_images: variant_images, limit: 1 %}
                                        {% endif %}
                                    {% endif %}
                            {% else %}
                                {% if product.media[0] != blank %}

                                    {% render 'v2-product-media', media: product.media[0], variant_images: variant_images, limit: 1 %}

                                    {% comment %}{% if haz_featured %}
                                        {{ product.metafields.custom.featured_image
                                            | image_url: width: 800
                                            | image_tag }}
                                    {% else %}

                                    {% endif %}{% endcomment %}
                                {% endif %}

                            {% endif %}

                            <a class="pt-image-link" href="{{ product.url }}"></a>

                        {%- else -%}
                            <div class="product__media-item">
                                <div
                                        class="product-media-container global-media-settings gradient"
                                        style="--ratio: 1.0; --preview-ratio: 1.0;"
                                >
                                    {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                                </div>
                            </div>
                        {%- endunless -%}
                    </div>

                    {% if template_type == 'product_hero' and media_image_count > 1 %}
                        <div class="v2-pt-thumblist">
                            <div class="">
                                {% for image in product.media  %}
                                    {% if forloop.index > 1 %}
                                    <div class="v2-image-container">
                                        {% render 'product-media', media: image %}
                                    </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>

                        {% if first_call_on_page %}
                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                document.querySelectorAll('product-thumb.-sectionid-{{ section_id }} .v2-image-container').forEach( (ele) => {
                                    ele.addEventListener('click', function(e) {
                                        e.preventDefault();
                                        const source = this;
                                        const target = document.querySelector('.v2-pt-image');
                                        const img_src = source.querySelector('img');
                                        const img_target = target.querySelector('img');

                                        target.appendChild( source.removeChild(img_src) );
                                        source.appendChild( target.removeChild(img_target) );
                                    })
                                })
                            });
                        </script>
                        {% endif %}
                    {% endif %}
                </div>

                {% # BOTTOM: INFO
                   # ---------------------- %}
                <div class="product__info-wrapper
                            sa-bg-dark-blue sa-col-white
                            {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                    <section
                            id="Prod uctInfo-{{ section_id }}"
                            class="product__info-container"
                            data-sect ion="{{ section_id }}"
                            data-url="{{ product.url }}"
                    >
                        {%- assign product_form_id = 'product-form-' | append: section_id -%}

                        <a class="pt-content" href="{{ product.url }}">


                            {% # RIBBON
                               # ----------------------- %}
                            {% if template_type == 'product_hero' and product.metafields.custom.ribbon_text != blank %}
                                <div class="v2-pt-ribbon">
                                    {{ product.metafields.custom.ribbon_text | metafield_text }}
                                </div>
                            {% endif %}

                            {% # TITLE (done)
                               # ----------------------- %}
                            <{{ title_tag }}>
                                    {{ product.metafields.custom.h1_heading | metafield_tag }}
                            </{{ title_tag }}>

                            <{{ title_tag }}>
                                    {{ product.metafields.custom.course_title | metafield_tag }}
                            </{{ title_tag }}>

                            
                            <div class="pt-description {{ class_description }}">
                                {{ product.metafields.custom.short_description | metafield_tag }}
                            </div>

                        </a>

                        <div class="pt-footer">

                            <div class="ptf-top">

                            {% # VARIANT PICKER (done)
                               # ----------------------- %}
                            {% render 'v2_product-variant-picker',
                                    product: product,
                                    swatch_shape: 'none',
                                    picker_type: 'dropdown',
                                    shopify_attributes: shopify_attributes,

                                        product_form_id: product_form_id
                                %}

                            </div>

                            <div class="ptf-bottom">

                                {% # BUY BUTTONS
                                   # ----------------------- %}
                                {%- render 'v2_buy-buttons',
                                        block: block,
                                        product: product,
                                        product_form_id: product_form_id,
                                        section_id: section_id,
                                        classes_button: classes_button
                                -%}


                                {% # PRICE (done?)
                                   # ----------------------- %}
                                <div id="price-{{ section_id }}" role="status" {{ shopify_attributes }}>
                                    {%- render 'v2_price',
                                            product: product,
                                            template: template_type,
                                            placeholder: placeholder,
                                            use_variant: true,
                                            show_badges: true,
                                            price_class: 'price--large',
                                            show_compare_at_price: true
                                    -%}
                                </div>

                                {%- if product.quantity_price_breaks_configured? -%}
                                    <div class="volume-pricing-note" id="Volume-Note-{{ section_id }}">
                                        <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                                    </div>
                                {%- endif -%}

                            </div>

                        </div>

                    </section>

                    {%- unless placeholder -%}
                        <div {{ shopify_attributes }} class="!m-0">
                            {%- form 'product', product -%}
                                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                                {{ form | payment_terms }}
                            {%- endform -%}
                        </div>
                    {%- endunless -%}

                </div>
            </div>

        </div>

        <script type="application/ld+json">
          {{ product | structured_data }}
        </script>

        {% # only load once per section %}
        {% if first_call_on_page %}
        <script>
            // TODO: replace #Option-template--25326316388729__product-grid-0 with sth unique

            // only enter here if we have not added the js before in another section
            if (!(typeof window.pt_initProductThumbVariationListener === "function")) {

                // setup the thumblist to be filled with the thumb_ids
                window.pt_variations_selector_list = window.pt_variations_selector_list || [];

                document.addEventListener("DOMContentLoaded", function () {
                    setTimeout(function () {
                        pt_initProductThumbVariationListener( window.pt_variations_selector_list );
                    }, 250);
                });

                function pt_initProductThumbVariationListener(pt_variations_selector_list) {

                    if (pt_variations_selector_list && pt_variations_selector_list.length) {
                        pt_variations_selector_list.forEach(variant_selector => {

                            // EVENT: selected variations have changed
                            var varsel = document.querySelector(variant_selector);
                            if (varsel) {
                                varsel.addEventListener('change', function (event) {
                                    const debug = false;
                                    const product_thumb = event.target.closest('product-thumb');

                                    if (product_thumb) {
                                        const product_id = product_thumb.getAttribute('data-product-id');
                                        const product_url = product_thumb.getAttribute('data-product-url');
                                        const options = [];
                                        const selected_product_variant_input = product_thumb.querySelector('.product-variant-id');

                                        // get selected values
                                        product_thumb.querySelectorAll('select').forEach((sel, index) => {
                                            options[index] = sel.value;
                                            if (debug) console.log(index, sel, sel.value);
                                        })

                                        if (debug) {
                                            console.log('product', product_id);
                                            console.log('product_url', product_url);
                                            console.log('selected_product_variant_input', selected_product_variant_input);
                                            console.log('options', options);
                                        }

                                        // get product information (could be cached, but meeeh, not worth it)
                                        fetch(product_url + '.js')
                                            .then(response => response.json())
                                            .then(product => {

                                                if (debug) console.log('product', product, product.variants);

                                                let selected_variant = product.variants.filter(variant => {
                                                    if (debug) {
                                                        console.log('filter', variant, variant.options.indexOf(options[0]), variant.options.indexOf(options[1]),
                                                            variant.options.indexOf(options[0]) > -1 && variant.options.indexOf(options[1]) > -1);
                                                        console.log(options, options[0], options[1], options[1] == null, options[1] == 'null');
                                                    }
                                                    return variant.options.indexOf(options[0]) > -1
                                                        && (variant.options.length == 1 || variant.options.indexOf(options[1]) > -1);
                                                })

                                                if (selected_variant && selected_variant.length) {
                                                    selected_variant = selected_variant[0];
                                                    if (debug) console.log('selected_variant', selected_variant);

                                                    // set selected
                                                    selected_product_variant_input.value = selected_variant.id;

                                                    // set price
                                                    pt_setProductThumbPrice(selected_variant, product, product_thumb);

                                                    if (selected_variant.available) {
                                                        pt_setAvailable(product_thumb);
                                                    } else {
                                                        pt_setSoldOut(product_thumb);
                                                    }

                                                } else {
                                                    console.error('No variant found!');
                                                }

                                            });

                                    } else {
                                        console.error('No product thumb found!');
                                    }
                                });
                            }

                        })

                    }
                }

                function pt_setSoldOut( product_thumb ) {
                    const button = product_thumb.querySelector('.v2-button');
                    button.querySelector('span').innerHTML = 'Sold Out';
                    button.classList.add('-disabled');
                }

                function pt_setAvailable( product_thumb ) {
                    const button = product_thumb.querySelector('.v2-button');
                    button.querySelector('span').innerHTML = 'Add to cart';
                    button.classList.remove('-disabled');
                }

                function pt_setProductThumbPrice(selected_variant, product, product_thumb) {

                    const ele_regular_price = product_thumb.querySelector('.price-item.price-item--regular');
                    const ele_sales_price = product_thumb.querySelector('.price-item.price-item--sale');
                    const ele_sales_regular_price = product_thumb.querySelector('.price__sale .price-item.price-item--regular');
                    const ele_sales_save_percentage = product_thumb.querySelector('.price__sale .price-save-percentage span');
                    const ele_v2_price = product_thumb.querySelector('.v2_price');

                    const currency_symbol = ele_regular_price.innerHTML.replace(/[0-9.,]/g, '').trim();
                    const regular_price = Math.round( parseInt( selected_variant.price ) / 100 );
                    const str_regular_price = currency_symbol + pt_formatPrice( regular_price );

                    // set regular price for both cases
                    ele_regular_price.innerHTML = str_regular_price;
                    ele_sales_price.innerHTML = str_regular_price;

                    // we have a sales price
                    if ( selected_variant.compare_at_price ) {
                        // show sales prices
                        ele_v2_price.classList.add('price--on-sale');
                        // update the sales prices (old price, percentage)
                        const sales_regular_price = Math.round( parseInt( selected_variant.compare_at_price ) / 100 );
                        ele_sales_regular_price.innerHTML =  currency_symbol + pt_formatPrice( sales_regular_price );

                        // calculate the percentage
                        // (i know i know, believe me, not elegant at all, horrible even, but... but i am sooo tireeeeeed)
                        const saving_percentage = ((regular_price / sales_regular_price * -1) + 1 ) * 100;
                        ele_sales_save_percentage.innerHTML = Math.round(saving_percentage);
                    // no sales price
                    } else {
                        // hide sales prices
                        ele_v2_price.classList.remove('price--on-sale');
                        // reset the sales prices
                        ele_sales_regular_price.innerHTML = '';
                        ele_sales_save_percentage.innerHTML = '';
                    }

                }

                // add thousands separator to price string
                function pt_formatPrice(price) {
                    return price.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                }
            }
        </script>

        <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

        {% comment %}{% if product.media.size > 0 %}{% endcomment %}
            <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
        {% comment %}{% endif %}{% endcomment %}

        {% endif %}

        <script>
            window.pt_variations_selector_list.push( '#shopify-section-{{ section.id }} product-thumb[data-product-id="{{ product.id }}"] variant-selects' );
        </script>
    {% else %}
        <div class="" style="padding: 1rem 2rem;background: #ff0000c2;color: white;border-radius: 0.5rem;display: inline-flex;">
            NO PRODUCT SELECTED
        </div>
    {% endif %}
</product-thumb>
