{% comment %}
  Renders a button with all the default configuration options we use

  Accepts:
  - data: {
            button_style: { string }
            button_text: { string }
            button_url: { string }
            button_icon: { image }
            button_align: { string }
            new_window: { boolean }
  }
  - classes: { string },
  - prefix: { string }

  Usage:
  {% render 'v2-button', data: data %}
{% endcomment %}

{% liquid

    # KEYS
    assign key_button_icon = 'button_icon'
    assign key_button_text = 'button_text'
    assign key_button_url = 'button_url'
    assign key_new_window = 'new_window'

    if prefix and prefix != blank
        assign key_button_icon =  prefix | append: key_button_icon
        assign key_button_text =  prefix | append: key_button_text
        assign key_button_url =  prefix | append: key_button_url
        assign key_new_window =  prefix | append: key_new_window
    endif


    assign tag = 'div'
    assign href = ''
    assign new_window = ''

    if data[ key_button_url ] != blank
        assign tag = 'a'
        assign href = ' href="' | append: data[ key_button_url ] | append: '"'
    endif

    if data[ key_new_window ] and data[ key_new_window ] == true and tag != 'a'
        assign new_window = ' target="_blank" '
    endif

    assign classes = classes | append: ' -style-' | append: data.button_style
    assign classes = classes | append: ' -size-' | append: data.button_size
    assign classes = classes | append: ' -align-' | append: data.button_align

%}

{% if data[ key_button_text ] != blank or data[ key_button_icon ] != blank %}

    <{{ tag }} class="v2-button {{ classes }}" {{ href }} {{ new_window }}>

        <span>

            {%- if data[ key_button_icon ] -%}
            <div class="v2-button-icon">
                {{ data[ key_button_icon ]
                | image_url: width: 44
                | image_tag: alt: data[ key_button_icon ].alt
                }}
            </div>
            {%- endif -%}

            {{ data[ key_button_text ] | remove: "<p>" | replace: '</p>', '<br>' | remove_last: '<br>' }}

        </span>

    </{{ tag }}>

{% endif %}