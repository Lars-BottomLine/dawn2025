    "v2_text_plus_image_ieWG7A": {
      "type": "v2_text-plus-image",
      "name": "t:lesections.textplusimage.presets.name",
      "settings": {
        "image": "shopify://shop_images/KCD_5008-Edit.jpg",
        "heading_text": "<p><strong>Our Company Story</strong></p>",
        "heading_type": "h1",
        "heading_size": "h2",
        "heading_no_decal": false,
        "heading_decal_left": true,
        "heading_strong_accented": false,
        "subheadline_text": "<p>At Study Active, we believe fitness education should feel human, not corporate.</p>",
        "subheadline_text_size": "copy-l",
        "subheadline_text_no_decal": false,
        "subheadline_text_strong_accented": false,
        "text": "<p>Behind every lesson, live chat, and qualification is a team of real people who care about your journey. From our expert tutors and course designers to our dedicated careers advisors, we’re here to support you from day one to the day you land your first job - and beyond.</p><p></p><p>We believe that true success is built on collaboration. By working closely with our valued partners and associations, we create strong networks that drive innovation, share expertise, and open new opportunities.</p>",
        "text_size": "copy-m",
        "text_no_decal": false,
        "text_strong_accented": false,
        "claim_text": "<p><strong>Together, we’re not just building connections - we’re building lasting impact for the industry and the communities we serve.</strong></p>",
        "claim_text_size": "copy-l",
        "claim_text_no_decal": false,
        "claim_text_strong_accented": false,
