      "blocks": {
        "member_MYn4Mn": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/1739004541621.jpg",
            "name": "Debra Stuart",
            "position": "CEO",
            "info": "Debra Stuart is the CEO of Study Active and a seasoned leader in the health and fitness industry with over 40 years of experience. Her career spans from hands-on roles as a fitness instructor and personal trainer to senior leadership positions shaping national training and education standards. A Chartered Director and Fellow of the Institute of Directors, Debra has played a pivotal role in developing high-quality qualifications and frameworks, including during her tenure as CEO of Premier Global and Treasurer of ukactive. At Study Active, she continues her mission to raise industry standards by promoting accessible, evidence-based education and supporting clear career pathways for future professionals."
          }
        },
        "member_R4AhB8": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/JB_Image.jpg",
            "name": "Julian Berriman",
            "position": "Director of Education",
            "info": "Julian Berriman is our Director of Education and brings over 30 years of experience in fitness education, curriculum design, and workforce development. He leads the design and delivery of training programmes that equip future fitness and wellness professionals with the skills, knowledge, and confidence needed to succeed in the industry. Julian also serves as Chair of EuropeActive’s Professional Standards Committee, overseeing the Sector Qualifications Framework and representing educational standards internationally. Alongside his role at Study Active, he continues to practise as an osteopath and personal trainer, maintaining his passion for health, fitness, and lifelong learning."
          }
        },
        "member_rUVYCd": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/IMG_20200812_113842_1.jpg",
            "name": "Carly Wallace",
            "position": "Managing Director",
            "info": "Carly began her career in health and fitness, working in business development across the UK and overseas with organisations such as Premier Training International, Active IQ, UFC Gyms and Les Mills. She later moved into senior eCommerce roles at global agencies, leading projects for major brands and specialising in growing online sales through Amazon and Shopify. At Study Active, Carly brings a wealth of commercial and digital expertise to her role as Managing Director, with a focus on enhancing the customer journey, supporting the team and driving sustainable growth for the business."
          }
        },
        "member_7PaAJz": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/DSCN0725.jpg",
            "name": "Ali Gower",
            "position": "Customer Experience Manager",
            "info": "Ali began her career in the active leisure industry in 2002, gaining experience in a range of gym roles as well as working as a tutor and assessor for training providers. She has since moved into senior leadership positions within the awarding and healthcare sectors, leading initiatives across customer experience, operations and service delivery. At Study Active, Ali uses her sector expertise and passion for continuous improvement to optimise business processes, enhance performance and deliver excellent customer experiences."
          }
        },
        "member_M8fdKe": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/Ben_Headshot.jpg",
            "name": "Ben Pratt",
            "position": "Content Expert",
            "info": "Ben is an international educator and consultant in the fitness, nutrition and wellness sectors, with over 20 years of experience in vocational health and fitness education. Holding an MSc in Holistic Nutrition and a BSc in Sports Science, he has authored numerous resources and developed accredited programmes in fitness coaching, personal training and nutrition. As founder of Fit2Succeed, Ben works with training providers and awarding bodies across the UK and Europe to deliver evidence-based education and e-learning. He has also contributed to the development of professional standards that continue to shape fitness education across Europe."
          }
        },
        "member_hfCaGc": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/105.jpg",
            "name": "Cara Standley",
            "position": "Lead Internal Verification",
            "info": "Cara’s passion for the fitness industry began in the 1990s when she qualified as a studio instructor. She progressed to personal training before discovering her enthusiasm for tutoring and joining a UK training provider. Her drive to raise the standard of fitness education took her to the Middle East, where she lived and worked for ten years and introduced regulated UK qualifications to the region. Now back in the UK, Cara continues to mentor fitness professionals who aspire to become tutors and delivers specialist qualifications such as Pre and Postnatal Fitness and Menopause Support. At Study Active, she is responsible for the Internal Verification strategy and standardisation."
          }
        },
        "member_PLYmqc": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/Facetune_06-01-2025-09-38-34.jpg",
            "name": "Charlie Reynolds",
            "position": "Tutor and Assessor",
            "info": "With over 13 years of experience in the fitness industry, Charlie has developed a career spanning education, business development and partnerships. She has worked with awarding bodies, training providers and local authorities, including the NHS, to deliver initiatives that prioritise health and wellbeing. Passionate about empowering others, Charlie combines her coaching business with her role as Tutor and Assessor at Study Active, where she supports learners to develop their skills and progress in the fitness industry."
          }
        },
        "member_UjfMj7": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/Headshot_5.jpg",
            "name": "Chris Walsh",
            "position": "Tutor and Assessor",
            "info": "Chris Walsh has been actively involved in fitness coaching for over 20 years, bringing a wealth of personal training experience to Study Active. He is a fully qualified tutor and assessor, passionate about helping students achieve both their fitness goals and career aspirations. Chris values physical movement alongside mental strength and focus, and brings a calm, friendly, and approachable style to his work. At Study Active, he regularly conducts gym and personal training assessments while providing exceptional coaching and mentoring to students."
          }
        },
        "member_UQhanA": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/DSCN0739.jpg",
            "name": "Claire McMenamin",
            "position": "Careers Adviser",
            "info": "Claire has over 30 years of experience in education and learning, beginning her career in course development at the University of Cambridge Exam Board before moving into employee development as a learning and development adviser and facilitator. She has worked with a wide range of organisations, from a major car manufacturer to a national housing association, supporting learners from apprentices through to middle management. At Study Active, Claire uses her experience to guide and advise learners on the best course choices to achieve their career goals in the fitness industry."
          }
        },
        "member_XEVVDU": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/Headshot_3.jpg",
            "name": "Colin Archer",
            "position": "Tutor and Assessor",
            "info": "Colin Archer has been involved in the fitness industry for many years and has a genuine passion for all aspects of health and fitness. With extensive experience in personal training, he helps clients achieve their fitness goals safely and efficiently. Colin is a fully qualified assessor and draws on his wealth of knowledge to guide students in turning their aspirations into reality, supporting them as they pursue the careers they desire. He conducts gym instructing and personal training assessments, preparing students with essential coaching skills and key practical insights."
          }
        },
        "member_JUCT37": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/thumbnail_IMG_2930.jpg",
            "name": "Dawn Fairey",
            "position": "Lead Pilates Educator",
            "info": "Dawn has over 40 years of experience in the fitness industry, with a background in contemporary dance and a lifelong passion for mindful movement. A specialist in Pilates, exercise to music, and children’s fitness, she has trained, assessed, and mentored thousands of aspiring fitness professionals across the UK.As a freelance tutor, assessor, and quality assurer for over two decades, Dawn delivers Level 2 and Level 3 fitness qualifications, develops accredited workshops, and supports national fitness standards. She continues to teach community Pilates classes and mentor new instructors, bringing a knowledgeable, kind, and encouraging approach to all learners."
          }
        },
        "member_7tkqRc": {
          "type": "member",
          "settings": {
            "image": "shopify://shop_images/DSCN0759.jpg",
            "name": "Elise Bowles",
            "position": "Careers Advisor",
            "info": "Elise Bowles is our Career Advisor and is dedicated to supporting learners as they take their first steps towards a successful career in the fitness industry. Before joining Study Active, she spent four years at awarding organisation Active IQ, where she gained extensive experience in customer experience, fitness education, and qualification frameworks. At Study Active, Elise guides prospective students through the decision-making and enrolment process and also represents the organisation at events, where she enjoys connecting with learners and partners. Outside of work, Elise is a qualified Rebound Fit instructor and is passionate about health, movement, and inspiring others to stay active."
          }
        },
        "member_JfdCqy": {
