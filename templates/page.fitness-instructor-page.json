    "v2_accordion_k4RYCF": {
      "type": "v2_accordion",
      "blocks": {
        "accordion_row_hdd7Gc": {
          "type": "accordion_row",
          "settings": {
            "heading": " What is a fitness instructor?",
            "row_content": "<p>A fitness instructor works with groups orindividuals to deliver effective workouts, often in gyms or community settings.It’s the first step in a rewarding career.</p>"
          }
        },
        "accordion_row_Ecbk7a": {
          "type": "accordion_row",
          "settings": {
            "heading": "Is \"fitness instructor\" the same as \"personal trainer\"?",
            "row_content": "<p>Not exactly. Fitness instructors typically supervise and lead group classes or gym sessions. Personal trainers work one-on-one with clients and usually require a Level 3 qualification.</p>"
          }
        },
        "accordion_row_xJwJKG": {
          "type": "accordion_row",
          "settings": {
            "heading": "What qualification do I need to become a fitness instructor?",
            "row_content": "<p>The Level 2 Certificate in Gym Instructing is the standard starting point.</p>"
          }
        },
        "accordion_row_nCWPNT": {
          "type": "accordion_row",
          "settings": {
            "heading": "How long does it take to qualify?",
            "row_content": "<p>You can complete your Level 2 course in just a few weeks, depending on your pace.</p>"
          }
        },
        "accordion_row_EqwDem": {
          "type": "accordion_row",
          "settings": {
            "heading": "Can I study online?",
            "row_content": "<p>Yes. Our courses are delivered through flexible, self-paced online learning, with optional in-person assessments.</p>"
          }
        },
        "accordion_row_RhLHkN": {
          "type": "accordion_row",
          "settings": {
            "heading": "What support will I get?",
            "row_content": "<p>You’ll have access to expert tutors, helpful resources, and a user-friendly online learning platform.</p>"
          }
        },
        "accordion_row_abViWR": {
          "type": "accordion_row",
          "settings": {
            "heading": "What kind of jobs can I get after qualifying?",
            "row_content": "<p>Fitness instructor, gym coach, group exercise leader, or entry-level trainer in gyms and leisure centres.</p>"
          }
        },
        "accordion_row_GBqQ83": {
          "type": "accordion_row",
          "settings": {
            "heading": "What is the next step after becoming a fitness instructor?",
            "row_content": "<p>You can progress to a <a href=\"/products/cimspa-certificate-in-personal-training-l3\" title=\"Level 3 Personal Trainer Course\">Level 3 Personal Training</a> qualification to work with clients on a one-to-one basis.</p>"
          }
        },
        "accordion_row_mqjap7": {
          "type": "accordion_row",
          "settings": {
            "heading": "Can I pay in instalments?",
            "row_content": "<p>Yes. We offer 0% finance and monthly payment plans.</p>"
          }
        },
        "accordion_row_AVRHRp": {
          "type": "accordion_row",
          "settings": {
            "heading": "Will I get job opportunities after the course?",
            "row_content": "<p>Yes. We offer guaranteed interviews with major UK gyms and career support throughout your journey.</p>"
          }
        }
