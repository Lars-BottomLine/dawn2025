    "v2_accordion_BTGkUz": {
      "type": "v2_accordion",
      "blocks": {
        "accordion_row_qLtxez": {
          "type": "accordion_row",
          "settings": {
            "heading": "1. Sports Massage Therapist",
            "row_content": "<p><strong>Salary: £25,000 – £40,000+ (or £30–£60+ per session self-employed)</strong></p><p><strong>Description:</strong> </p><p>Provide hands-on treatment to help clients recover from injury, relieve pain, and improve mobility. Work in sports clubs, physiotherapy clinics, gyms, or as a freelance therapist.</p><p><strong>Growth outlook:</strong> </p><p>Steady demand from both active individuals and the public seeking preventative care and rehabilitation.</p>"
          }
        },
        "accordion_row_kckNXq": {
          "type": "accordion_row",
          "settings": {
            "heading": "2. Rehabilitation & Injury Prevention Specialist",
            "row_content": "<p><strong>Salary: £26,000 – £42,000+</strong></p><p><strong>Description:</strong> </p><p>Design recovery and prevention programmes for clients post-injury or surgery, combining sports massage with corrective exercise and mobility work. Often employed in multidisciplinary clinics or by sports teams.</p><p><strong>Growth outlook:</strong> </p><p>Strong growth as awareness of injury prevention and recovery support continues to increase.</p>"
          }
        },
        "accordion_row_qzDLzY": {
          "type": "accordion_row",
          "settings": {
            "heading": "3. Sports Massage & Personal Training Coach",
            "row_content": "<p><strong>Salary: £28,000 – £50,000+ (self-employed earnings vary)</strong></p><p><strong>Description:</strong> Offer a combined service of sports massage and personal training, helping clients rehabilitate, regain strength, and improve overall fitness in one package.</p><p><strong>Growth outlook:</strong> High demand from clients who prefer one trusted professional for both recovery and ongoing fitness.</p><p></p>"
          }
        }
      },
      "block_order": [
        "accordion_row_qLtxez",
        "accordion_row_kckNXq",
        "accordion_row_qzDLzY"
