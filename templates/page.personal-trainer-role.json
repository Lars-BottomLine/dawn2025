        "margin_bottom": 0
      }
    },
    "v2_flexible_TawhVX": {
      "type": "v2_flexible",
      "blocks": {
        "headline_AU8XkH": {
          "type": "headline",
          "settings": {
            "heading_text": "<p>Why Become a Personal Trainer?</p><p></p>",
            "heading_align": "left",
            "heading_width": "full",
            "heading_type": "h3",
            "heading_size": "h1",
            "heading_no_decal": false,
            "heading_decal_left": true,
            "heading_strong_accented": false
          }
        },
        "subheadline_pwBQpL": {
          "type": "subheadline",
          "settings": {
            "text": "<p>Becoming a <a href=\"https://studyactive.co.uk/blogs/news/11-reasons-why-you-should-become-a-personal-trainer\" title=\"https://studyactive.co.uk/blogs/news/11-reasons-why-you-should-become-a-personal-trainer\"><strong>personal trainer</strong></a> can be a rewarding career for people who are passionate about fitness and helping others improve their health. It offers flexibility, strong earning potential, and the opportunity to make a real impact on people's wellbeing.</p>",
            "text_align": "left",
            "text_width": "full",
            "text_size": "copy-l",
            "text_no_decal": false,
            "text_strong_accented": false,
            "margin_top": 16,
            "margin_bottom": 0
          }
        },
        "textcol_e4EdeH": {
          "type": "textcol",
          "settings": {
            "left_text": "<p></p><p><strong>High Demand for Fitness Professionals</strong><br/><br/>The UK fitness industry continues to grow as more people focus on improving their health and wellbeing. Gyms, studios, and online coaching platforms regularly look for qualified personal trainers to support their members.<br/></p>",
            "left_text_size": "copy-l",
            "left_text_no_decal": false,
            "left_text_strong_accented": false,
            "right_text": "<p></p><p><strong>Flexible Working Opportunities</strong></p><p></p><p>Personal trainers can work in gyms, run their own freelance business, or offer online coaching. This flexibility allows many trainers to set their own schedule and build a career around their lifestyle.<br/></p>",
            "right_text_size": "copy-l",
            "right_text_no_decal": false,
            "right_text_strong_accented": false,
            "margin_top": 0,
            "margin_bottom": 0
          }
        },
        "textcol_A4w7Fw": {
          "type": "textcol",
          "settings": {
            "left_text": "<p></p><p><strong>Rewarding Work</strong></p><p><br/>Helping clients achieve their fitness goals - whether it's losing weight, building strength, or improving confidence - can make personal training a highly fulfilling career.<br/></p>",
            "left_text_size": "copy-l",
            "left_text_no_decal": false,
            "left_text_strong_accented": false,
            "right_text": "<p></p><p><strong>Strong Earning Potential</strong></p><p><br/>Personal trainer earnings vary depending on experience and how you work. Newly qualified trainers may earn <strong>£20,000–£30,000 per year</strong>, while experienced trainers often earn <strong>£40,000–£60,000+. </strong><br/></p>",
            "right_text_size": "copy-l",
            "right_text_no_decal": false,
            "right_text_strong_accented": false,
            "margin_top": 0,
            "margin_bottom": 0
          }
        }
      },
