    "v2_text_plus_image_Q3MpEb": {
      "type": "v2_text-plus-image",
      "name": "t:lesections.textplusimage.presets.name",
      "settings": {
        "image": "shopify://shop_images/woman-jumping-workout.jpg",
        "heading_text": "<p>What is a Personal Trainer?</p>",
        "heading_type": "h3",
        "heading_size": "h3",
        "heading_no_decal": false,
        "heading_decal_left": false,
        "heading_strong_accented": true,
        "subheadline_text": "",
        "subheadline_text_size": "copy-l",
        "subheadline_text_no_decal": false,
        "subheadline_text_strong_accented": false,
        "text": "<p>A <strong>personal trainer</strong> (PT) is a qualified fitness professional who works with individuals or small groups to help them achieve specific health and fitness goals. These goals may include weight loss, muscle building, improving strength and endurance, recovering from injury, or improving overall health and wellbeing.</p><p>Personal trainers assess a client’s current fitness level, discuss their goals, and create <strong>tailored exercise programmes </strong>designed to deliver safe and effective results. They also demonstrate correct exercise techniques, provide motivation and accountability, and help clients stay consistent with their training.</p><p>Most personal trainers work in <strong>gyms, health clubs, fitness studios</strong>, <strong>or as self-employed coaches</strong>, offering both in-person sessions and online coaching.<br/>To work professionally in the UK, personal trainers typically need a <strong>Level 3 Personal Trainer qualification</strong>, which provides the knowledge and skills required to train clients safely and effectively.<br/></p>",
        "text_size": "copy-l",
        "text_no_decal": false,
        "text_strong_accented": false,
        "claim_text": "",
        "claim_text_size": "copy-l",
        "claim_text_no_decal": false,
        "claim_text_strong_accented": false,
        "custom_class_names": "",
        "button_text": "",
        "button_url": "",
        "button_style": "primary",
        "button_size": "small",
        "button_new_window": false,
        "bkgr_color": "white",
        "decal_top": true,
        "decal_bottom": false,
        "padding_top": 0,
