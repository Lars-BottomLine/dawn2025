    "v2_flexible_UFPbM8": {
      "type": "v2_flexible",
      "blocks": {
        "headline_xHiKaw": {
          "type": "headline",
          "settings": {
            "heading_text": "<p>Key Responsibilities of a Long Term Conditions Exercise Specialist</p>",
            "heading_align": "left",
            "heading_width": "full",
            "heading_type": "h3",
            "heading_size": "h1",
            "heading_no_decal": false,
            "heading_decal_left": true,
            "heading_strong_accented": false
          }
        },
        "subheadline_Vnhqbt": {
          "type": "subheadline",
          "settings": {
            "text": "<p>A Long-Term Conditions Exercise Specialist has a higher level of responsibility than a standard fitness professional. The role focuses on delivering safe, effective exercise programmes for clients with medical conditions, while working within a clearly defined professional scope of practice.</p>",
            "text_align": "left",
            "text_width": "full",
            "text_size": "copy-l",
            "text_no_decal": false,
            "text_strong_accented": false,
            "margin_top": 16,
            "margin_bottom": 0
          }
        },
        "textcol_7kaeFQ": {
          "type": "textcol",
          "settings": {
            "left_text": "<p></p><p><strong>Medical Screening & Risk Assessment</strong><br/><br/>Review client health information, interpret referral details and identify any contraindications to exercise. This ensures all activity is safe and appropriate for the individual.<br/><strong><br/>Monitoring & Supervision</strong><br/><br/>Observe how clients respond to exercise in real time, making adjustments to ensure safety, comfort and effectiveness throughout each session.<br/></p><p><br/><strong>Working Within Referral Frameworks</strong><br/><br/>Operate within GP referral schemes or healthcare pathways, communicating appropriately with medical professionals while staying within your professional scope.<br/></p>",
            "left_text_size": "copy-l",
            "left_text_no_decal": false,
            "left_text_strong_accented": false,
            "right_text": "<p></p><p><strong>Individualised Programme Design</strong></p><p><br/>Create structured, progressive exercise programmes tailored to each client’s condition, limitations and goals, adapting intensity and exercise selection as needed.<br/><br/><strong>Lifestyle & Behaviour Change Support</strong></p><p></p><p>Help clients build long-term healthy habits by providing guidance on physical activity, consistency and confidence alongside their medical management.<br/><br/><strong>Maintaining Professional Standards</strong><br/></p><p>Stay up to date with industry guidelines, complete continuing professional development (CPD), and ensure appropriate insurance is in place for working with higher-risk populations.<br/><br/></p><p></p>",
            "right_text_size": "copy-l",
            "right_text_no_decal": false,
            "right_text_strong_accented": false,
            "margin_top": 0,
            "margin_bottom": 0
          }
        }
      },
      "block_order": [
        "headline_xHiKaw",
        "subheadline_Vnhqbt",
        "textcol_7kaeFQ"
      ],
