    "v2_flexible_pmWRpA": {
      "type": "v2_flexible",
      "blocks": {
        "headline_E3nxjd": {
          "type": "headline",
          "settings": {
            "heading_text": "<p>Why Choose a Career as a Long Term Conditions Exercise Specialist?</p><p></p>",
            "heading_align": "left",
            "heading_width": "full",
            "heading_type": "h3",
            "heading_size": "h1",
            "heading_no_decal": false,
            "heading_decal_left": true,
            "heading_strong_accented": false
          }
        },
        "subheadline_EhfiVj": {
          "type": "subheadline",
          "settings": {
            "text": "<p>Becoming a <strong>Long Term Conditions Exercise Specialis</strong>t<strong> </strong>is a rewarding career choice for people who are xxx.</p>",
            "text_align": "left",
            "text_width": "full",
            "text_size": "copy-l",
            "text_no_decal": false,
            "text_strong_accented": false,
            "margin_top": 16,
            "margin_bottom": 0
          }
        },
        "textcol_yRtRKz": {
          "type": "textcol",
          "settings": {
            "left_text": "<p></p><p><strong>Growing Industry Demand</strong><br/><br/>With <a href=\"https://www.theguardian.com/society/2024/oct/21/number-of-people-with-chronic-pain-in-england-to-rise-by-19m-by-2040\" title=\"https://www.theguardian.com/society/2024/oct/21/number-of-people-with-chronic-pain-in-england-to-rise-by-19m-by-2040\">rising rates of chronic illness</a> in the UK, there is increasing demand for qualified professionals who can safely support clients with long-term health conditions. Exercise referral and specialist roles are becoming more common across gyms, healthcare settings and community programmes.<br/></p><p></p>",
            "left_text_size": "copy-l",
            "left_text_no_decal": false,
            "left_text_strong_accented": false,
            "right_text": "<p></p><p><strong>Diverse Career Opportunities</strong></p><p></p><p>As a <a href=\"/products/active-iq-level-3-online-diploma-in-supporting-clients-with-long-term-conditions\" title=\"CIMSPA Endorsed Level 3 Online Diploma in Supporting Clients with Long-term Conditions\">Long-Term Conditions specialist</a>, you can work across a wide range of environments, including leisure centres, private practice, rehabilitation settings and GP referral schemes.</p><p></p><p>You may also choose to combine this qualification with a <a href=\"/products/cimspa-certificate-in-personal-training-l3\" title=\"CIMSPA Endorsed Level 3 Certificate in Personal Training\">Level 3 Personal Training Course</a> to expand your client base and increase earning potential.<br/></p>",
            "right_text_size": "copy-l",
            "right_text_no_decal": false,
            "right_text_strong_accented": false,
            "margin_top": 0,
            "margin_bottom": 0
          }
        },
        "textcol_cb3YQx": {
          "type": "textcol",
          "settings": {
            "left_text": "<p></p><p><strong>Meaningful Client Impact</strong></p><p><br/>This is one of the most rewarding areas of the fitness industry. You’ll help clients regain confidence, improve mobility and take control of their health, often after years of inactivity or medical challenges.</p>",
            "left_text_size": "copy-l",
            "left_text_no_decal": false,
            "left_text_strong_accented": false,
            "right_text": "<p></p><p><strong>Strong Earning Potential</strong></p><p><br/>Long Term Conditions Exercise Specialists in the UK can earn between <strong>£25,000 and £40,000+ per year</strong>, depending on experience, setting and whether you offer additional services such as personal training. </p><p></p><p>Specialists working privately or combining multiple qualifications can earn significantly more through session-based income. </p>",
            "right_text_size": "copy-l",
            "right_text_no_decal": false,
            "right_text_strong_accented": false,
            "margin_top": 0,
            "margin_bottom": 0
          }
        }
