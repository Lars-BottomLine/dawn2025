    "v2_text_plus_image_Q3MpEb": {
      "type": "v2_text-plus-image",
      "name": "t:lesections.textplusimage.presets.name",
      "settings": {
        "image": "shopify://shop_images/11_d6cf613f-34cf-414d-9c38-89dd821e7126.png",
        "heading_text": "<p>What is a Long-Term Conditions Exercise Specialist?</p><p></p>",
        "heading_type": "h3",
        "heading_size": "h3",
        "heading_no_decal": false,
        "heading_decal_left": false,
        "heading_strong_accented": true,
        "subheadline_text": "",
        "subheadline_text_size": "copy-l",
        "subheadline_text_no_decal": false,
        "subheadline_text_strong_accented": false,
        "text": "<p>A <strong>Long-Term Conditions Exercise Specialist</strong> is a qualified fitness professional who designs safe, tailored exercise programmes for individuals living with chronic health conditions such as diabetes, cardiovascular disease, arthritis and respiratory conditions. </p><p>Unlike standard personal trainers, these specialists have advanced knowledge of clinical considerations, including contraindications to exercise, risk stratification and programme adaptation for medically controlled conditions. </p><p>They work within a defined professional scope to help clients improve functional capacity, manage symptoms and enhance overall quality of life through structured physical activity. </p>",
        "text_size": "copy-l",
        "text_no_decal": false,
        "text_strong_accented": false,
        "claim_text": "",
        "claim_text_size": "copy-l",
        "claim_text_no_decal": false,
        "claim_text_strong_accented": false,
