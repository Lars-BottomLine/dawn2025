      }
    },
    "v2_flexible_TawhVX": {
      "type": "v2_flexible",
      "blocks": {
        "textcol_ehwmiU": {
          "type": "textcol",
          "settings": {
            "left_text": "<p>Most professionals begin their journey with a <a href=\"https://studyactive.co.uk/products/cimspa-level-2-certificate-in-fitness-instruction\" target=\"_blank\"><span style=\"text-decoration:underline\">Level 2 Gym Instructor Course</span></a> or progress from a <a href=\"https://studyactive.co.uk/products/cimspa-certificate-in-personal-training-l3\" target=\"_blank\"><span style=\"text-decoration:underline\">Level 3 Personal Training Course</span></a> before specialising in long-term conditions. </p>",
            "left_text_size": "copy-l",
            "left_text_no_decal": false,
            "left_text_strong_accented": false,
            "right_text": "<p><strong>Common conditions you may work with include:</strong> </p><ul><li>Cardiovascular disease </li><li>Type 2 diabetes </li><li>Obesity and weight-related conditions </li><li>Arthritis and joint conditions </li><li>Respiratory conditions (e.g. COPD, asthma) </li><li>Osteoporosis </li></ul>",
            "right_text_size": "copy-l",
            "right_text_no_decal": false,
            "right_text_strong_accented": false,
            "margin_top": 0,
            "margin_bottom": 0
          }
        }
      },
