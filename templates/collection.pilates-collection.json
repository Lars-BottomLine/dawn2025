    "v2_accordion_BTGkUz": {
      "type": "v2_accordion",
      "blocks": {
        "accordion_row_qLtxez": {
          "type": "accordion_row",
          "settings": {
            "heading": "1. Mat-Based Pilates Instructor ",
            "row_content": "<p><strong>Salary: £22,000 – £35,000+ (or £25–£50+ per class as a freelancer) </strong></p><p>Description: </p><p>Teach Pilates matwork classes in studios, gyms, or community centres. Guide participants through safe, effective exercises to improve posture, flexibility, and core strength. </p><p>Growth outlook: </p><p>Strong demand as more people seek low-impact, mindful exercise for health and wellbeing.</p>"
          }
        },
        "accordion_row_kckNXq": {
          "type": "accordion_row",
          "settings": {
            "heading": "2. Reformer Pilates Instructor",
            "row_content": "<p><strong>Salary: £25,000 – £40,000+ (premium rates for private sessions) </strong></p><p>Description: </p><p>Specialise in teaching Pilates using the Reformer, a piece of equipment that adds resistance and variety to workouts. Often taught in boutique studios or wellness centres. </p><p>Growth outlook: </p><p>Rapid growth, especially in urban areas where boutique Pilates studios are thriving.</p>"
          }
