    "v2_flexible_XDXkJK": {
      "type": "v2_flexible",
      "blocks": {
        "headline_9Ey8px": {
          "type": "headline",
          "settings": {
            "heading_text": "<p>Step 4: Start earning</p>",
            "heading_align": "left",
