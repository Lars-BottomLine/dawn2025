          }
        },
        "accordion_row_xJwJKG": {
          "type": "accordion_row",
          "settings": {
            "heading": "Is this different from a personal trainer?",
            "row_content": "<p>Yes. Gym instructors typically work on the gym floor or lead group sessions. Personal trainers work one-to-one with clients and require a Level 3 qualification.</p>"
