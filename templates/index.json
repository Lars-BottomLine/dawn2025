        "subheadline_text_size": "copy-xl",
        "subheadline_text_no_decal": false,
        "subheadline_text_strong_accented": false,
        "text": "<p>Our Level 3 Gym Instructing & Personal Trainer Diploma is a <strong>CIMSPA-endorsed</strong> and <strong>Ofqual-regulated qualification</strong> aimed at anyone wishing to become a fully qualified personal trainer.</p><p>This flexible approach uses <strong>home-study, e-learning, webinars, dedicated tutorials, practical workshop </strong>as well as ongoing support from support tutors which allows you to work at your own pace and wrap your study around other commitments.</p>",
        "text_size": "copy-m",
        "text_no_decal": false,
        "text_strong_accented": false,
        "claim_text": "<p>This course comes with unlimited support & fitness education from fitness specialist tutors. <strong>This also comes with 20 free online CPDs and lifelong career support.</strong></p>",
