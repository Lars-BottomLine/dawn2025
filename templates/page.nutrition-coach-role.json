        "margin_bottom": 0
      }
    },
    "v2_flexible_TawhVX": {
      "type": "v2_flexible",
      "blocks": {
        "headline_AU8XkH": {
          "type": "headline",
          "settings": {
            "heading_text": "<p>Why Choose a Career as a Nutrition Coach?</p><p></p>",
            "heading_align": "left",
            "heading_width": "full",
            "heading_type": "h3",
            "heading_size": "h1",
            "heading_no_decal": false,
            "heading_decal_left": true,
            "heading_strong_accented": false
          }
        },
        "subheadline_pwBQpL": {
          "type": "subheadline",
          "settings": {
            "text": "<p>A career as a <a href=\"/products/level-4-nutrition\" title=\"RSPH Level 4 Award in Nutrition\">Nutrition Coach</a> allows you to turn your passion for health and fitness into meaningful, flexible work that has a real impact on people’s lives.</p>",
            "text_align": "left",
            "text_width": "full",
            "text_size": "copy-l",
            "text_no_decal": false,
            "text_strong_accented": false,
            "margin_top": 16,
            "margin_bottom": 0
          }
        },
        "textcol_e4EdeH": {
          "type": "textcol",
          "settings": {
            "left_text": "<p></p><p><strong>Growing Industry Demand</strong><br/><br/>As awareness around nutrition, obesity, and overall wellbeing continues to grow in the UK, so does the demand for qualified professionals who can support healthier lifestyles. This makes nutrition coaching an increasingly attractive and future-proof career choice.<br/><br/></p>",
            "left_text_size": "copy-l",
            "left_text_no_decal": false,
            "left_text_strong_accented": false,
            "right_text": "<p></p><p><strong>Flexible Career Path</strong></p><p></p><p>One of the biggest advantages of becoming a Nutrition Coach is the flexibility it offers. You can work in a gym environment, alongside personal training, or build an online coaching business that fits around your lifestyle. Many coaches combine multiple income streams, creating greater freedom and long-term stability.<br/></p>",
            "right_text_size": "copy-l",
            "right_text_no_decal": false,
            "right_text_strong_accented": false,
            "margin_top": 0,
            "margin_bottom": 0
          }
        },
        "textcol_A4w7Fw": {
          "type": "textcol",
          "settings": {
            "left_text": "<p></p><p><strong>Rewarding Client Impact</strong></p><p><br/>Helping clients improve their health, confidence, and relationship with food can be incredibly rewarding. As a Nutrition Coach, you play a key role in supporting long-term lifestyle change, making it more than just a job.<br/><br/></p>",
            "left_text_size": "copy-l",
            "left_text_no_decal": false,
            "left_text_strong_accented": false,
            "right_text": "<p></p><p><strong>Earning Potential</strong></p><p><br/>Entry-level Nutrition Coaches typically earn between <strong>£22,000–£30,000</strong> annually, with experienced online or freelance coaches earning <strong>£35,000–£60,000+</strong> depending on client base and specialisation.<br/></p>",
            "right_text_size": "copy-l",
            "right_text_no_decal": false,
            "right_text_strong_accented": false,
            "margin_top": 0,
            "margin_bottom": 0
          }
        }
      },
      "block_order": [
        "headline_AU8XkH",
