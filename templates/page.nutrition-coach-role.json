    "v2_text_plus_image_Q3MpEb": {
      "type": "v2_text-plus-image",
      "name": "t:lesections.textplusimage.presets.name",
      "settings": {
        "image": "shopify://shop_images/Role_Page_Website_Image_-_Nutrition_Coach.png",
        "heading_text": "<p>What is a Nutrition Coach?</p>",
        "heading_type": "h3",
        "heading_size": "h3",
        "heading_no_decal": false,
        "heading_decal_left": false,
        "heading_strong_accented": true,
        "subheadline_text": "",
        "subheadline_text_size": "copy-l",
        "subheadline_text_no_decal": false,
        "subheadline_text_strong_accented": false,
        "text": "<p>A <strong>Nutrition Coach</strong> is a qualified professional who provides evidence-based guidance to help people improve their diet, health, and overall wellbeing. </p><p>Rather than diagnosing medical conditions, Nutrition Coaches work with generally healthy individuals to build sustainable eating habits, support body composition goals, and enhance physical performance. This can include helping clients <a href=\"https://studyactive.co.uk/blogs/news/how-to-lose-belly-fat-a-complete-guide\" title=\"https://studyactive.co.uk/blogs/news/how-to-lose-belly-fat-a-complete-guide\">lose body fat</a>, <a href=\"https://studyactive.co.uk/blogs/news/how-much-protein-to-build-muscle-daily-intake-best-sources\" title=\"https://studyactive.co.uk/blogs/news/how-much-protein-to-build-muscle-daily-intake-best-sources\">build muscle</a>, improve energy levels, or develop a healthier relationship with food. </p><p>Nutrition Coaches assess dietary habits, educate clients on key principles such as <a href=\"https://studyactive.co.uk/blogs/news/how-many-calories-should-i-eat-a-day-a-guide-to-counting-calories\" title=\"https://studyactive.co.uk/blogs/news/how-many-calories-should-i-eat-a-day-a-guide-to-counting-calories\">calories</a> and macronutrients, and create personalised strategies that fit around their lifestyle, training, and long-term goals. </p>",
        "text_size": "copy-l",
        "text_no_decal": false,
        "text_strong_accented": false,
        "claim_text": "",
        "claim_text_size": "copy-l",
        "claim_text_no_decal": false,
        "claim_text_strong_accented": false,
        "custom_class_names": "",
