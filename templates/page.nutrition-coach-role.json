    "v2_text_plus_image_TKtxGU": {
      "type": "v2_text-plus-image",
      "name": "t:lesections.textplusimage.presets.name",
      "settings": {
        "image": "shopify://shop_images/Gym_Instructor_Salary_Expectation_Table_-_Website_Smaller_Size.png",
        "heading_text": "<p>How Much Does a Nutrition Coach Earn?</p>",
        "heading_type": "h3",
        "heading_size": "h3",
        "heading_no_decal": false,
        "heading_decal_left": false,
        "heading_strong_accented": true,
        "subheadline_text": "<p> </p>",
        "subheadline_text_size": "copy-l",
        "subheadline_text_no_decal": false,
        "subheadline_text_strong_accented": false,
        "text": "<p>In the UK, salaries vary depending on experience, specialisation, and whether you work employed, freelance, or online. </p><ul><li>Entry-level Nutrition Coaches typically earn between <strong>£22,000 and £30,000 per year </strong></li><li>Those combining nutrition with <a href=\"https://studyactive.co.uk/products/cimspa-certificate-in-personal-training-l3\" title=\"https://studyactive.co.uk/products/cimspa-certificate-in-personal-training-l3\">personal training</a> often earn <strong>£30,000 to £40,000 </strong></li><li>Experienced or online coaches can earn <strong>£40,000 to £60,000+</strong>, with top earners exceeding this through premium or niche services </li></ul><p></p><p>Many coaches also charge per session or offer coaching packages, with rates typically ranging from £25 to £100+ depending on experience and service level </p>",
        "text_size": "copy-l",
        "text_no_decal": false,
        "text_strong_accented": false,
        "claim_text": "",
        "claim_text_size": "copy-l",
