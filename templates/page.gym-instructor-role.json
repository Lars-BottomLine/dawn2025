    "v2_text_plus_image_Q3MpEb": {
      "type": "v2_text-plus-image",
      "name": "t:lesections.textplusimage.presets.name",
      "settings": {
        "image": "shopify://shop_images/Feature_Images_-_How_to_Become_a_PT_1.png",
        "heading_text": "<p>What is a Gym Instructor??</p>",
        "heading_type": "h3",
        "heading_size": "h3",
        "heading_no_decal": false,
        "heading_decal_left": false,
        "heading_strong_accented": true,
        "subheadline_text": "",
        "subheadline_text_size": "copy-l",
        "subheadline_text_no_decal": false,
        "subheadline_text_strong_accented": false,
        "text": "<p>A <strong>Gym Instructor (also known as a Fitness Instructor)</strong> is a qualified fitness professional who works on the gym floor helping members exercise safely and effectively. </p><p>Gym instructors play an important role in supporting people at the start of their fitness journey. They help members understand how to use equipment correctly, follow structured workout programmes, and build confidence in the gym environment. </p><p>Typical responsibilities of a gym instructor include: </p><ul><li><strong>Inducting new members</strong> and explaining how gym equipment works </li><li><strong>Demonstrating correct exercise technique</strong> for strength and cardio training </li><li><strong>Designing basic gym programmes</strong> tailored to beginner fitness goals </li><li><strong>Monitoring member safety and wellbeing</strong> on the gym floor </li><li><strong>Creating a motivating and welcoming gym environment</strong> </li></ul>",
        "text_size": "copy-l",
        "text_no_decal": false,
        "text_strong_accented": false,
        "claim_text": "",
        "claim_text_size": "copy-l",
