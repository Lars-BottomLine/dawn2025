    "v2_flexible_UFPbM8": {
      "type": "v2_flexible",
      "blocks": {
        "headline_xHiKaw": {
          "type": "headline",
          "settings": {
            "heading_text": "<p>Key Responsibilities of a Gym Instructor</p>",
            "heading_align": "left",
            "heading_width": "full",
            "heading_type": "h3",
            "heading_size": "h1",
            "heading_no_decal": false,
            "heading_decal_left": true,
            "heading_strong_accented": false
          }
        },
        "subheadline_Vnhqbt": {
          "type": "subheadline",
          "settings": {
            "text": "<p>Gym instructors are responsible for creating a <strong>safe, supportive, and motivating training environment</strong> for gym members. Their role involves supervising the gym floor, helping members use equipment correctly, and designing simple workout programmes for beginners. </p><p></p><p>Below are some of the <strong>main responsibilities of a gym instructor</strong> in a typical gym or health club environment. <br/></p>",
            "text_align": "left",
            "text_width": "full",
            "text_size": "copy-l",
            "text_no_decal": false,
            "text_strong_accented": false,
