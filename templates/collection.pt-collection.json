      "blocks": {
        "accordion_row_qLtxez": {
          "type": "accordion_row",
          "settings": {
            "heading": "1. Personal Trainer ",
            "row_content": "<p><strong>Salary: £25,000 – £45,000+ (higher if self-employed with a strong client base) </strong></p><p>Description: </p><p>Help clients smash their fitness goals with tailored workout programmes and nutrition advice. Work face-to-face in gyms, leisure centres, or as your own boss. </p><p>Growth outlook: </p><p>Consistent demand in gyms, health clubs, and private studios across the UK. </p>"
