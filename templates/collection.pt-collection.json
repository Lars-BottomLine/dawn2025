      }
    },
    "v2_accordion_BTGkUz": {
      "type": "v2_accordion",
      "blocks": {
        "accordion_row_qLtxez": {
          "type": "accordion_row",
          "settings": {
            "heading": "1. Personal Trainer ",
            "row_content": "<p><strong>Salary: £25,000 – £45,000+ (higher if self-employed with a strong client base) </strong></p><p>Description: </p><p>Help clients smash their fitness goals with tailored workout programmes and nutrition advice. Work face-to-face in gyms, leisure centres, or as your own boss. </p><p>Growth outlook: </p><p>Consistent demand in gyms, health clubs, and private studios across the UK. </p>"
          }
        },
        "accordion_row_kckNXq": {
          "type": "accordion_row",
          "settings": {
            "heading": "2.  Online Personal Trainer ",
            "row_content": "<p><strong>Salary: £25,000 – £45,000+</strong></p><p>Description: </p><p>Coach clients remotely using apps, video calls, and social media. A perfect way to train anyone, anywhere — and keep earning without being tied to a single gym. </p><p>Growth outlook: </p><p>Rapid growth as more clients want flexible, home-based training options. </p>"
          }
        },
        "accordion_row_qzDLzY": {
          "type": "accordion_row",
          "settings": {
            "heading": "3. Group Trainer / Instructor ",
            "row_content": "<p><strong>Salary: £22,000 – £38,000+ (or £25–£50+ per class as a freelancer) </strong></p><p> <strong>Description:</strong> </p><p> Lead high-energy classes in gyms, parks, or even cruise ships. From circuits to bootcamps, motivate and manage groups to hit their goals together. </p><p> <strong>Growth outlook:</strong> </p><p> Steady demand through gyms, leisure centres, and community fitness programmes</p>"
          }
        },
        "accordion_row_bxGW6H": {
          "type": "accordion_row",
          "settings": {
            "heading": "4. Studio Cycling Instructor ",
            "row_content": "<p><strong>Salary: £28,000 – £50,000+ (plus bonuses for popular classes) </strong></p><p><strong>Description:</strong> </p><p>One of the most in-demand group training roles in the UK. Run music-driven spin classes that clients love and keep coming back for. </p><p><strong>Growth outlook:</strong> </p><p>Strong and growing as indoor cycling gains popularity in gyms and workplace wellness programmes. </p>"
          }
        }
      },
      "block_order": [
        "accordion_row_qLtxez",
