    "v2_flexible_VjFj8L": {
      "type": "v2_flexible",
      "blocks": {
        "headline_D8g7GW": {
          "type": "headline",
          "settings": {
            "heading_text": "<p>Step 4: Start earning</p>",
            "heading_align": "left",
            "heading_width": "full",
