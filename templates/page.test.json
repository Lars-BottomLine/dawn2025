      "name": "t:lesections.textplusimage.presets.name",
      "settings": {
        "image": "shopify://shop_images/trainer-helping-client-with-fitness.webp",
        "heading_text": "<p>Let us do the heavy lifting</p>",
        "heading_type": "h2",
        "heading_size": "h2",
        "heading_no_decal": false,
        "heading_decal_left": true,
        "heading_strong_accented": false,
        "subheadline_text": "<p>This is your moment to do something that really moves you.</p>",
        "subheadline_text_size": "copy-xl",
        "subheadline_text_no_decal": false,
        "subheadline_text_strong_accented": false,
        "text": "<p>With Study Active, you get everything you need to become a fully qualified fitness professional. Learn online, in your own time, with expert tutors by your side and real opportunities waiting at the finish line. We’ll guide you through every step, from your first login to guaranteed job interviews with top UK gyms. Bring your drive and passion, we’ve got the rest covered.</p>",
