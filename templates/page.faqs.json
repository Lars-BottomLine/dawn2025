      "blocks": {
        "accordion_row_eT64aw": {
          "type": "accordion_row",
          "settings": {
            "heading": "Why are your courses competitively priced? ",
            "row_content": "<p>We deliver our courses through blended learning which keeps our overheads low. We pass those savings on to you while still providing the same high-quality tuition, full support and nationally recognised qualifications.</p>"
          }
        },
        "accordion_row_NgeiCb": {
          "type": "accordion_row",
          "settings": {
            "heading": "Do I have to pay in full upfront or are there other payment options? ",
            "row_content": "<p>No. You can choose to pay in full or take advantage of our interest free monthly instalment plans if you are a UK learner. We can help you to set up a plan that fits your budget.</p>"
          }
        },
        "accordion_row_x9QmVT": {
          "type": "accordion_row",
          "settings": {
            "heading": "What is your refund policy for Study Active courses? ",
            "row_content": "<p> You can find our full refund policy in our Terms and Conditions, and we are happy to answer any questions before you enrol.</p>"
          }
        },
        "accordion_row_4dy97D": {
