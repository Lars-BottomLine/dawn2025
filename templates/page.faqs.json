        },
        "accordion_row_QLiyrx": {
          "type": "accordion_row",
          "settings": {
            "heading": "Can you help me find work?",
            "row_content": "<p>Absolutely! We would be happy to look over your CV and provide some guidance. We also have guaranteed interviews to a select number of nationwide gyms and a jobs board to help you locate one.</p>"
