.4-6.425a.247.247 0 0 1 .02-.022Z" fill="currentColor"></path></svg></div></div></div></span><div class="gf-il-content item-content" data-index="6" data-key="content1" style="padding-left: 45px"><div data-label="Text Block" id="e-1703502154874" class="element-wrap" data-id="1703502154874"><div class="elm text-edit gf_gs-text-paragraph-1 gf-elm-left gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-exc=""><p style="text-align: inherit!important;">Active IQ Level 4 Physical Activity & Lifestyle Strategies for Managing Low Back Pain</p></div></div></div></li><li style="margin-bottom: 3px"><span class="gf-il-icon item-content" data-index="7" data-key="content" style="width: 45px"><div data-label="Icon" data-ver="2" id="e-1703502154226" class="element-wrap" data-id="1703502154226"><div class="elm gf-elm-center gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-exc=""><div class="gf_icon-wrap"><svg fill="currentColor" height="100%" class="gf_icon" icon-class="bootstrap-outline-check-lg" width="100%" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022Z" fill="currentColor"></path></svg></div></div></div></span><div class="gf-il-content item-content" data-index="7" data-key="content1" style="padding-left: 45px"><div data-label="Text Block" id="e-1703502154164" class="element-wrap" data-id="1703502154164"><div class="elm text-edit gf_gs-text-paragraph-1 gf-elm-left gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-exc=""><p style="text-align: inherit!important;">Active IQ Level 4 Advanced Personal Training&nbsp;</p></div></div></div></li></ul></div></div><div class="element-wrap" id="e-1529485236263" data-label="Text Block" data-icon="gpicon-textblock" data-id="1529485236263"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-exc=""><p><span style="font-family: inherit; font-size: inherit; font-weight: inherit; letter-spacing: 0px; text-align: inherit;">(Any combination of these courses as a "bundle" is possible, please speak to us about this).</span><br></p><p><br><b style="font-family: inherit; font-size: inherit; text-align: inherit; letter-spacing: 0px;">How much funding?</b><span style="font-family: inherit; font-size: inherit; font-weight: inherit; text-align: inherit; letter-spacing: 0px;">&nbsp;</span><br><span style="font-family: inherit; font-size: inherit; font-weight: inherit; text-align: inherit; letter-spacing: 0px;">ELCAS will fund 80% of a training course, up to the value of the contribution amount that you are eligible for. There is always a need for a 20% personal contribution, so the lesser the price of the course, the lesser the personal contribution would be. For example our Level 3 Diploma in Personal Training is £999.&nbsp;</span><span style="font-family: inherit; font-size: inherit; font-weight: inherit; text-align: inherit; letter-spacing: 0px;">This would be funded as follows:</span><br></p></div></div></div></div></div></div><!--gfsplit--><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1703581951367" class="gf_row" data-icon="gpicon-row" data-id="1703581951367"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1703581951387" data-id="1703581951387"><div class="element-wrap" id="e-1703581958319" data-label="Heading" data-icon="gpicon-heading" data-id="1703581958319" data-ver="1"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc="" data-gemlang="en"><h1 class="gf_gs-text-heading-2">How do I <span style="color: rgb(1, 75, 117);">apply?</span></h1></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1703582174517" class="gf_row horizontal-steps" data-icon="gpicon-row" data-id="1703582174517" data-layout-lg="12" data-extraclass="horizontal-steps" data-layout-md="12" data-layout-sm="12" data-layout-xs="12"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1703582174492" data-id="1703582174492"><div data-label="Icon List" data-key="icon-list" data-atomgroup="module" id="m-1703582267178" class="module-wrap" data-icon="gpicon-iconlist" data-ver="1.0" data-id="1703582267178"><div class="module gf_module-left gf_module-left-lg gf_module--md gf_module--sm gf_module--xs "><ul class="gf_icon-list"><li style="margin-bottom: 15px"><span class="gf-il-icon item-content" data-index="1" data-key="content" style="width: 230px"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1703582614927" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1703582614927"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><p>Step <br><span style="color: rgb(252, 252, 252);">01</span></p></div></div><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1703582365693" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1703582365693" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/b01eeffc-d7e3-424b-99d7-465da7397e9c/-/format/auto/-/preview/3000x3000/-/quality/lighter/Ellipse%201862.png" alt="" class="gf_image" data-gemlang="en" data-width="80%" data-height="auto" title="" width="296" height="295" natural-width="296" natural-height="295"></div></div></span><div class="gf-il-content item-content" data-index="1" data-key="content1"><div data-label="Text Block" id="e-1703582267178-2" class="element-wrap" data-id="1703582267178-2"><div class="elm text-edit gf_gs-text-paragraph-1 gf-elm-left gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><p style="text-align: inherit!important;">Firstly, please contact us to have a chat about the course to make sure it is the course for you. Then if you are interested, you will need to make sure you are eligible for ELCAS funding (your Education centre will be able to advise you).</p></div></div></div></li><li style="margin-bottom: 15px"><span class="gf-il-icon item-content" data-index="2" data-key="content" style="width: 230px"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1703588774817" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1703588774817"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><p>Step <br><span style="color: rgb(252, 252, 252);">02</span></p></div></div><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1703588774832" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1703588774832" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/b01eeffc-d7e3-424b-99d7-465da7397e9c/-/format/auto/-/preview/3000x3000/-/quality/lighter/Ellipse%201862.png" alt="" class="gf_image" data-gemlang="en" data-width="80%" data-height="auto" title="" width="296" height="295" natural-width="296" natural-height="295"></div></div></span><div class="gf-il-content item-content" data-index="2" data-key="content1"><div data-label="Text Block" id="e-1703588774820" class="element-wrap" data-id="1703588774820"><div class="elm text-edit gf_gs-text-paragraph-1 gf-elm-left gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><p style="text-align: inherit!important;">You will then need to complete am Enhanced Learning Credit (ELC) form with the course details. You can obtain this form from us and we can guide you on completing it as there will be specific information like dates that need inputting.</p></div></div></div></li><li style="margin-bottom: 15px"><span class="gf-il-icon item-content" data-index="3" data-key="content" style="width: 230px"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1703588778267" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1703588778267"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><p>Step <br><span style="color: rgb(252, 252, 252);">03</span></p></div></div><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1703588778239" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1703588778239" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/b01eeffc-d7e3-424b-99d7-465da7397e9c/-/format/auto/-/preview/3000x3000/-/quality/lighter/Ellipse%201862.png" alt="" class="gf_image" data-gemlang="en" data-width="80%" data-height="auto" title="" width="296" height="295" natural-width="296" natural-height="295"></div></div></span><div class="gf-il-content item-content" data-index="3" data-key="content1"><div data-label="Text Block" id="e-1703588778414" class="element-wrap" data-id="1703588778414"><div class="elm text-edit gf_gs-text-paragraph-1 gf-elm-left gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><p style="text-align: inherit!important;">You will then need to send your completed ELC form to ELCAS for approval.</p><p style="text-align: inherit!important;"><br></p></div></div></div></li><li style="margin-bottom: 15px"><span class="gf-il-icon item-content" data-index="4" data-key="content" style="width: 230px"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1703588779637" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1703588779637"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><p>Step <br><span style="color: rgb(252, 252, 252);">04</span></p></div></div><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1703588779718" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1703588779718" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/b01eeffc-d7e3-424b-99d7-465da7397e9c/-/format/auto/-/preview/3000x3000/-/quality/lighter/Ellipse%201862.png" alt="" class="gf_image" data-gemlang="en" data-width="80%" data-height="auto" title="" width="296" height="295" natural-width="296" natural-height="295"></div></div></span><div class="gf-il-content item-content" data-index="4" data-key="content1"><div data-label="Text Block" id="e-1703588779739" class="element-wrap" data-id="1703588779739"><div class="elm text-edit gf_gs-text-paragraph-1 gf-elm-left gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><p style="text-align: inherit!important;">Once approved you will receive a Claim Authorisation Note (CAN) from ELCAS. This needs to be forwarded to us. Once received we will need to take payment for 20% of the course fee from you.</p></div></div></div></li><li style="margin-bottom: 15px"><span class="gf-il-icon item-content" data-index="5" data-key="content" style="width: 230px"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1703588780712" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1703588780712"><div class="elm text